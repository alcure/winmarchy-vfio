#!/usr/bin/env python3
"""GPU holders for the Winmarchy VFIO Omarchy overlay."""
from __future__ import annotations

import base64
import glob
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

GPU = os.environ.get("WIN11_VFIO_GPU", "0000:01:00.0")
VM = os.environ.get("WIN11_VFIO_VM", "win11")
VM_SHARED = os.environ.get("WIN11_VFIO_VM_SHARED", "win11-shared")
PLUGIN_DIR = Path(__file__).resolve().parent.parent
CONFIG = Path.home() / ".config/omarchy/winmarchy-vfio.json"
STATE = Path.home() / ".local/state/omarchy/winmarchy-vfio.json"
QEMU_NS = "http://libvirt.org/schemas/domain/qemu/1.0"
TPM_STATE = f"/var/lib/libvirt/swtpm/{os.environ.get('WIN11_VFIO_UUID', '489b869a-5b61-4be1-bf63-94db23193370')}"
SUPPORTED = {"pt-BR", "en-US"}

IGNORED = {
    "omarchy-shell",
    "Xwayland",
    "pipewire",
    "pipewire-pulse",
    "wireplumber",
    "dbus-daemon",
    "systemd",
    "looking-glass-client",
    "qemu-system-x86_64",
    "python3",
    "gate",
}


def normalize_locale(value: str | None) -> str | None:
    if not value:
        return None
    raw = value.strip().replace("_", "-")
    lower = raw.lower()
    if lower.startswith("pt"):
        return "pt-BR"
    if lower.startswith("en"):
        return "en-US"
    if raw in SUPPORTED:
        return raw
    return None


def locale_id() -> str:
    forced = normalize_locale(os.environ.get("WIN11_VFIO_LOCALE"))
    if forced:
        return forced
    if CONFIG.exists():
        try:
            forced = normalize_locale(json.loads(CONFIG.read_text()).get("locale"))
            if forced:
                return forced
        except (OSError, json.JSONDecodeError):
            pass
    return normalize_locale(os.environ.get("LANG")) or "en-US"


def load_strings() -> dict:
    path = PLUGIN_DIR / "i18n" / f"{locale_id()}.json"
    fallback = PLUGIN_DIR / "i18n" / "en-US.json"
    data = {}
    for candidate in (fallback, path):
        if candidate.exists():
            data.update(json.loads(candidate.read_text()))
    return data


def t(key: str, **kwargs) -> str:
    text = load_strings().get(key, key)
    return text.format(**kwargs) if kwargs else text


def gpu_paths() -> list[str]:
    found: list[str] = []
    for pattern in ("/dev/nvidia*", f"/dev/dri/by-path/pci-{GPU}-*"):
        for raw in glob.glob(pattern):
            if os.path.exists(raw):
                found.append(os.path.realpath(raw))
                found.append(raw)
    # unique preserve order
    out: list[str] = []
    for p in found:
        if p not in out:
            out.append(p)
    return out


def proc_meta(pid: int) -> dict | None:
    try:
        comm = Path(f"/proc/{pid}/comm").read_text().strip()
        raw = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        argv = [a.decode("utf-8", "replace") for a in raw if a]
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return None
    return {"pid": pid, "comm": comm, "argv": argv, "exe": exe}


def pids_on_gpu() -> list[dict]:
    paths = set(gpu_paths())
    basenames = {os.path.basename(p) for p in paths}
    holders: dict[int, dict] = {}
    for ent in os.listdir("/proc"):
        if not ent.isdigit():
            continue
        pid = int(ent)
        fd_dir = f"/proc/{pid}/fd"
        try:
            for fd in os.listdir(fd_dir):
                try:
                    tgt = os.readlink(f"{fd_dir}/{fd}")
                except OSError:
                    continue
                real = os.path.realpath(tgt) if tgt.startswith("/") else tgt
                name = os.path.basename(tgt)
                if tgt in paths or real in paths or name in basenames:
                    meta = proc_meta(pid)
                    if meta:
                        holders[pid] = meta
                    break
        except OSError:
            continue
    return list(holders.values())


def classify(proc: dict) -> str | None:
    blob = " ".join([proc["comm"], proc.get("exe", ""), *proc.get("argv", [])]).lower()
    if proc["comm"] in IGNORED or "omarchy-shell" in blob:
        return None
    if "hyprland" in blob:
        return "hyprland"
    if "steamwebhelper" in blob or "/steam" in blob or proc["comm"] in {"steam", "steamwebhelper"}:
        return "steam"
    if "nautilus" in blob:
        return "nautilus"
    if "voxtype" in blob:
        return "voxtype"
    if "ollama" in blob:
        return "ollama"
    return f"pid:{proc['pid']}"


LABELS = {
    "hyprland": "label_hyprland",
    "omarchy-shell": "label_shell",
    "steam": "label_steam",
    "nautilus": "label_nautilus",
    "voxtype": "label_voxtype",
    "ollama": "label_ollama",
}

STOP = {
    "steam": ["steam", "-shutdown"],
    "nautilus": ["nautilus", "--quit"],
    "voxtype": ["systemctl", "--user", "stop", "voxtype.service"],
    "ollama": ["systemctl", "stop", "ollama.service"],
}

START = {
    "steam": ["/usr/bin/steam", "-silent"],
    "nautilus": ["/usr/bin/nautilus"],
    "voxtype": ["/usr/bin/systemctl", "--user", "start", "voxtype.service"],
    "ollama": ["/usr/bin/systemctl", "start", "ollama.service"],
}


def groups_from_procs(procs: list[dict]) -> list[dict]:
    buckets: dict[str, list[dict]] = {}
    for proc in procs:
        gid = classify(proc)
        if not gid:
            continue
        buckets.setdefault(gid, []).append(proc)
    groups = []
    for gid, members in buckets.items():
        fatal = gid in {"hyprland", "omarchy-shell"} or gid.split(":")[0] in {"hyprland"}
        if gid.startswith("pid:"):
            label = members[0]["comm"]
            stop = None
            start = members[0]["argv"] or [members[0]["exe"]]
        else:
            label = t(LABELS[gid]) if gid in LABELS else gid
            stop = STOP.get(gid)
            start = START.get(gid)
            fatal = gid in {"hyprland", "omarchy-shell"}
        groups.append(
            {
                "id": gid,
                "label": label,
                "fatal": fatal,
                "pids": [m["pid"] for m in members],
                "comms": sorted({m["comm"] for m in members}),
                "stop": stop,
                "start": start,
            }
        )
    groups.sort(key=lambda g: (not g["fatal"], g["label"].lower()))
    return groups


def holders_payload() -> dict:
    procs = pids_on_gpu()
    groups = groups_from_procs(procs)
    return {
        "ok": True,
        "gpu": GPU,
        "count": len(groups),
        "fatal": any(g["fatal"] for g in groups),
        "groups": groups,
    }


def run(cmd: list[str], timeout: float = 20) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def log(msg: str) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with (STATE.parent / "winmarchy-vfio.log").open("a") as fh:
        fh.write(f"{time.strftime('%H:%M:%S')} {msg}\n")


def kill_pid(pid: int) -> None:
    try:
        os.kill(pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass


def wait_gone(matcher, seconds: float = 8) -> None:
    deadline = time.time() + seconds
    while time.time() < deadline:
        left = [p for p in pids_on_gpu() if matcher(p)]
        if not left:
            return
        for p in left:
            kill_pid(p["pid"])
        time.sleep(0.35)


def release(groups: list[dict]) -> dict:
    released = []
    errors = []
    for g in groups:
        if g.get("fatal"):
            errors.append(t("cannot_stop", label=g["label"]))
            continue
        gid = g.get("id")
        try:
            if gid == "steam":
                run(["/usr/bin/steam", "-shutdown"], timeout=12)
                wait_gone(lambda p: classify(p) == "steam", 10)
                run(["/usr/bin/pkill", "-TERM", "-x", "steam"], timeout=5)
                run(["/usr/bin/pkill", "-TERM", "-x", "steamwebhelper"], timeout=5)
            elif gid == "nautilus":
                run(["/usr/bin/nautilus", "--quit"], timeout=8)
                wait_gone(lambda p: classify(p) == "nautilus", 6)
            elif gid == "voxtype":
                run(["/usr/bin/systemctl", "--user", "stop", "voxtype.service"], timeout=8)
                wait_gone(lambda p: classify(p) == "voxtype", 6)
            elif g.get("stop"):
                run(g["stop"], timeout=15)
        except Exception as exc:
            errors.append(f"{g['label']}: {exc}")
        for pid in g.get("pids", []):
            kill_pid(int(pid))
        released.append(g)
        log(f"released {gid} pids={g.get('pids')}")
    wait_gone(lambda p: classify(p) not in {None, "hyprland"}, 8)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({"groups": released, "at": time.time()}, indent=2))
    still = holders_payload()
    blocking = [g for g in still["groups"] if not g["fatal"]]
    return {
        "ok": not blocking,
        "released": released,
        "still": still,
        "errors": errors,
    }


def restore(groups: list[dict] | None = None) -> dict:
    if groups is None:
        if STATE.exists():
            groups = json.loads(STATE.read_text()).get("groups", [])
        else:
            groups = []
    started = []
    errors = []
    env = os.environ.copy()
    env["LIBVA_DRIVER_NAME"] = "iHD"
    env["__GLX_VENDOR_LIBRARY_NAME"] = "mesa"
    env["__EGL_VENDOR_LIBRARY_FILENAMES"] = "/usr/share/glvnd/egl_vendor.d/50_mesa.json"
    for g in groups:
        start = g.get("start")
        if not start:
            continue
        cmd = list(start)
        if cmd and cmd[0] == "steam":
            cmd[0] = "/usr/bin/steam"
        if cmd and cmd[0] == "nautilus":
            cmd[0] = "/usr/bin/nautilus"
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env, start_new_session=True)
            started.append(g["id"])
            log(f"restore once {g['id']}: {cmd}")
        except Exception as exc:
            errors.append(f"{g.get('label', g['id'])}: {exc}")
    if STATE.exists():
        STATE.unlink()
    return {"ok": not errors, "started": started, "errors": errors}


def _virsh(*args: str, timeout: float = 20) -> subprocess.CompletedProcess:
    return run(["/usr/bin/virsh", "-c", "qemu:///system", *args], timeout=timeout)


def _domstate(name: str) -> str:
    return (_virsh("domstate", name, timeout=10).stdout or "").strip()


def _other_profile_running(mode: str) -> str | None:
    other = VM_SHARED if mode == "vfio" else VM
    if _domstate(other) == "running":
        return other
    return None


def _shared_uuid() -> str:
    proc = _virsh("domuuid", VM_SHARED, timeout=10)
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip()
    import uuid

    return str(uuid.uuid4())


def _tag(el) -> str:
    return el.tag.rsplit("}", 1)[-1]


SHARED_WIDTH = 1920
SHARED_HEIGHT = 1080


def host_resolution() -> tuple[int, int]:
    try:
        env_w, env_h = os.environ.get("WIN11_SPICE_WIDTH"), os.environ.get("WIN11_SPICE_HEIGHT")
        if env_w and env_h:
            return int(env_w), int(env_h)
        out = subprocess.check_output(["/usr/bin/hyprctl", "monitors", "-j"], text=True, timeout=5)
        mons = json.loads(out)
        if not mons:
            return 3440, 1440
        focused = next((m for m in mons if m.get("focused")), None)
        pick = focused or max(mons, key=lambda m: int(m.get("width") or 0) * int(m.get("height") or 0))
        return int(pick.get("width") or 3440), int(pick.get("height") or 1440)
    except Exception:
        return 3440, 1440


def _set_shared_video(devices, ET) -> None:
    width, height = SHARED_WIDTH, SHARED_HEIGHT
    for video in list(devices.findall("video")):
        devices.remove(video)
    video = ET.SubElement(devices, "video")
    model = ET.SubElement(video, "model")
    model.set("type", "virtio")
    model.set("heads", "1")
    model.set("primary", "yes")
    accel = ET.SubElement(model, "acceleration")
    accel.set("accel3d", "no")
    res = ET.SubElement(model, "resolution")
    res.set("x", str(width))
    res.set("y", str(height))
    for inp in list(devices.findall("input")):
        if inp.get("type") == "tablet":
            devices.remove(inp)


def build_shared_xml(source_xml: str) -> str:
    import xml.etree.ElementTree as ET

    ET.register_namespace("qemu", QEMU_NS)
    root = ET.fromstring(source_xml)
    name = root.find("name")
    if name is not None:
        name.text = VM_SHARED
    title = root.find("title")
    if title is not None:
        title.text = t("shared_title")
    uuid_el = root.find("uuid")
    if uuid_el is not None:
        uuid_el.text = _shared_uuid()
    devices = root.find("devices")
    if devices is not None:
        for hd in list(devices.findall("hostdev")):
            if hd.get("type") == "pci":
                devices.remove(hd)
        for graphics in devices.findall("graphics"):
            if graphics.get("type") == "spice":
                graphics.set("autoport", "no")
                graphics.set("port", "5900")
                gl = graphics.find("gl")
                if gl is None:
                    gl = ET.SubElement(graphics, "gl")
                gl.set("enable", "no")
                for tag, key, val in (
                    ("image", "compression", "off"),
                    ("jpeg", "compression", "never"),
                    ("zlib", "compression", "never"),
                    ("playback", "compression", "off"),
                ):
                    el = graphics.find(tag)
                    if el is None:
                        el = ET.SubElement(graphics, tag)
                    el.set(key, val)
        _set_shared_video(devices, ET)
        tpm_backend = devices.find("./tpm/backend")
        if tpm_backend is not None:
            tpm_backend.set("persistent_state", "yes")
            source = tpm_backend.find("source")
            if source is None:
                source = ET.SubElement(tpm_backend, "source")
            source.set("path", TPM_STATE)
    return ET.tostring(root, encoding="unicode")


def _virsh_define(xml: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["/usr/bin/virsh", "-c", "qemu:///system", "define", "/dev/stdin"],
        input=xml,
        capture_output=True,
        text=True,
        timeout=20,
    )


def ensure_shared_domain() -> dict:
    dumped = _virsh("dumpxml", VM, "--inactive", timeout=15)
    if dumped.returncode != 0:
        return {"ok": False, "error": (dumped.stderr or dumped.stdout or t("read_win11")).strip()}
    import xml.etree.ElementTree as ET

    xml = build_shared_xml(dumped.stdout)
    proc = _virsh_define(xml)
    if proc.returncode != 0:
        root = ET.fromstring(xml)
        backend = root.find("./devices/tpm/backend")
        if backend is not None:
            backend.attrib.pop("persistent_state", None)
            source = backend.find("source")
            if source is not None:
                backend.remove(source)
        xml = ET.tostring(root, encoding="unicode")
        proc = _virsh_define(xml)
    if proc.returncode != 0:
        root = ET.fromstring(xml)
        for model in root.findall("./devices/video/model"):
            res = model.find("resolution")
            if res is not None:
                model.remove(res)
        xml = ET.tostring(root, encoding="unicode")
        proc = _virsh_define(xml)
    if proc.returncode != 0:
        return {"ok": False, "error": (proc.stderr or proc.stdout or t("define_shared")).strip()}
    log("defined win11-shared")
    return {"ok": True}


def _guest_agent(vm: str, payload: dict, timeout: float = 20) -> dict | None:
    proc = run(
        ["/usr/bin/virsh", "-c", "qemu:///system", "qemu-agent-command", vm, json.dumps(payload)],
        timeout=timeout,
    )
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout).get("return")
    except json.JSONDecodeError:
        return None


def wait_guest_agent(vm: str, seconds: float = 90) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        if _guest_agent(vm, {"execute": "guest-ping"}, timeout=8) is not None:
            return True
        time.sleep(2)
    return False


def guest_write(vm: str, path: str, content: str) -> bool:
    opened = _guest_agent(vm, {"execute": "guest-file-open", "arguments": {"path": path, "mode": "w"}})
    if opened is None:
        return False
    handle = opened if isinstance(opened, int) else opened.get("handle", opened)
    raw = content.encode("utf-8")
    offset = 0
    while offset < len(raw):
        chunk = raw[offset : offset + 20480]
        wrote = _guest_agent(
            vm,
            {
                "execute": "guest-file-write",
                "arguments": {"handle": handle, "buf-b64": base64.b64encode(chunk).decode("ascii")},
            },
        )
        if not wrote:
            _guest_agent(vm, {"execute": "guest-file-close", "arguments": {"handle": handle}})
            return False
        offset += int(wrote.get("count") or len(chunk))
    _guest_agent(vm, {"execute": "guest-file-close", "arguments": {"handle": handle}})
    return True


def guest_pshell(vm: str, command: str, timeout: float = 40) -> bool:
    remote = r"C:\ProgramData\winmarchy-run.ps1"
    if not guest_write(vm, remote, command):
        return False
    started = _guest_agent(
        vm,
        {
            "execute": "guest-exec",
            "arguments": {
                "path": r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe",
                "arg": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", remote],
                "capture-output": False,
            },
        },
        timeout=15,
    )
    if not started or "pid" not in started:
        return False
    pid = started["pid"]
    deadline = time.time() + timeout
    while time.time() < deadline:
        status = _guest_agent(vm, {"execute": "guest-exec-status", "arguments": {"pid": pid}}, timeout=10)
        if status and status.get("exited"):
            return int(status.get("exitcode") or 1) == 0
        time.sleep(0.5)
    return False


SHARED_DISPLAY_PS = r"""
$ErrorActionPreference = 'SilentlyContinue'
Get-PnpDevice -Class Display | ForEach-Object {
  $virtio = $_.FriendlyName -match 'VirtIO|Virtio|Red Hat'
  $vdd = ($_.FriendlyName -match 'Virtual Display') -or ($_.InstanceId -like 'ROOT\DISPLAY*')
  if ($virtio) { Enable-PnpDevice -InstanceId $_.InstanceId -Confirm:$false }
  elseif ($vdd) { Disable-PnpDevice -InstanceId $_.InstanceId -Confirm:$false }
}
exit 0
"""

NATIVE_DISPLAY_PS = r"""
$ErrorActionPreference = 'SilentlyContinue'
$ps1 = 'C:\ProgramData\winmarchy-native.ps1'
@'
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class WmNat2 {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Ansi)]
  public struct DEVMODE {
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string dmDeviceName;
    public short dmSpecVersion, dmDriverVersion, dmSize, dmDriverExtra;
    public int dmFields, dmPositionX, dmPositionY, dmDisplayOrientation, dmDisplayFixedOutput;
    public short dmColor, dmDuplex, dmYResolution, dmTTOption, dmCollate;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string dmFormName;
    public short dmLogPixels;
    public int dmBitsPerPel, dmPelsWidth, dmPelsHeight, dmDisplayFlags, dmDisplayFrequency;
    public int dmICMMethod, dmICMIntent, dmMediaType, dmDitherType, dmReserved1, dmReserved2, dmPanningWidth, dmPanningHeight;
  }
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Ansi)]
  public struct DISPLAY_DEVICE {
    public int cb;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=32)] public string DeviceName;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=128)] public string DeviceString;
    public int StateFlags;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=128)] public string DeviceID;
    [MarshalAs(UnmanagedType.ByValTStr, SizeConst=128)] public string DeviceKey;
  }
  [DllImport("user32.dll")] public static extern bool EnumDisplayDevices(string a, uint i, ref DISPLAY_DEVICE d, uint f);
  [DllImport("user32.dll")] public static extern bool EnumDisplaySettings(string dev, int mode, ref DEVMODE dm);
  [DllImport("user32.dll")] public static extern int ChangeDisplaySettingsEx(string dev, ref DEVMODE dm, IntPtr w, int f, IntPtr p);
  [DllImport("user32.dll", EntryPoint="ChangeDisplaySettingsEx")] public static extern int ChangeDisplaySettingsExNull(string dev, IntPtr dm, IntPtr w, int f, IntPtr p);
  public static int Apply(int wantW, int wantH) {
    string vdd = null; string virtio = null;
    for (uint i = 0; i < 16; i++) {
      DISPLAY_DEVICE dd = new DISPLAY_DEVICE();
      dd.cb = Marshal.SizeOf(dd);
      if (!EnumDisplayDevices(null, i, ref dd, 0)) break;
      if (dd.DeviceString.IndexOf("Virtual Display") >= 0 || dd.DeviceString.IndexOf("Looking Glass") >= 0) vdd = dd.DeviceName;
      if (dd.DeviceString.IndexOf("Red Hat") >= 0 || dd.DeviceString.IndexOf("VirtIO") >= 0) virtio = dd.DeviceName;
    }
    string target = virtio != null ? virtio : vdd;
    if (target == null) return 2;
    DEVMODE pick = new DEVMODE();
    bool found = false; int bestHz = -1;
    for (int m = 0; m < 400; m++) {
      DEVMODE t = new DEVMODE();
      t.dmSize = (short)Marshal.SizeOf(t);
      if (!EnumDisplaySettings(target, m, ref t)) break;
      if (t.dmPelsWidth == wantW && t.dmPelsHeight == wantH && t.dmDisplayFrequency >= bestHz) {
        pick = t; found = true; bestHz = t.dmDisplayFrequency;
      }
    }
    if (!found) return 3;
    pick.dmSize = (short)Marshal.SizeOf(pick);
    pick.dmPositionX = 0; pick.dmPositionY = 0;
    pick.dmFields = 0x20 | 0x80000 | 0x100000 | 0x400000;
    ChangeDisplaySettingsEx(target, ref pick, IntPtr.Zero, 0x01 | 0x10 | 0x10000000, IntPtr.Zero);
    ChangeDisplaySettingsExNull(null, IntPtr.Zero, IntPtr.Zero, 0, IntPtr.Zero);
    return 0;
  }
}
"@
[WmNat2]::Apply(__WIDTH__, __HEIGHT__)
'@ | Set-Content -LiteralPath $ps1 -Encoding UTF8
$exp = Get-CimInstance Win32_Process -Filter "Name='explorer.exe'" | Select-Object -First 1
if ($exp) {
  $own = Invoke-CimMethod -InputObject $exp -MethodName GetOwner
  $ru = if ($own.Domain) { "$($own.Domain)\$($own.User)" } else { $own.User }
  Unregister-ScheduledTask -TaskName 'WinmarchyNative' -Confirm:$false
  $action = New-ScheduledTaskAction -Execute "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" -Argument "-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$ps1`""
  $principal = New-ScheduledTaskPrincipal -UserId $ru -LogonType Interactive -RunLevel Highest
  Register-ScheduledTask -TaskName 'WinmarchyNative' -Action $action -Principal $principal -Force | Out-Null
  if (-not ('WmSessRun' -as [type])) {
    Add-Type -TypeDefinition @"
using System;
using System.Runtime.InteropServices;
using System.Text;
public class WmSessRun {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
  public struct STARTUPINFO {
    public int cb; public string lpReserved; public string lpDesktop; public string lpTitle;
    public int dwX, dwY, dwXSize, dwYSize, dwXCountChars, dwYCountChars, dwFillAttribute, dwFlags;
    public short wShowWindow, cbReserved2; public IntPtr lpReserved2, hStdInput, hStdOutput, hStdError;
  }
  [StructLayout(LayoutKind.Sequential)]
  public struct PROCESS_INFORMATION { public IntPtr hProcess, hThread; public int dwProcessId, dwThreadId; }
  [DllImport("kernel32.dll", SetLastError=true)] public static extern IntPtr OpenProcess(uint a, bool i, int pid);
  [DllImport("advapi32.dll", SetLastError=true)] public static extern bool OpenProcessToken(IntPtr p, uint a, out IntPtr t);
  [DllImport("advapi32.dll", SetLastError=true)] public static extern bool DuplicateTokenEx(IntPtr h, uint a, IntPtr t, int impersonation, int type, out IntPtr dup);
  [DllImport("userenv.dll", SetLastError=true)] public static extern bool CreateEnvironmentBlock(out IntPtr env, IntPtr token, bool inherit);
  [DllImport("userenv.dll", SetLastError=true)] public static extern bool DestroyEnvironmentBlock(IntPtr env);
  [DllImport("advapi32.dll", SetLastError=true, CharSet=CharSet.Unicode)]
  public static extern bool CreateProcessAsUser(IntPtr h, string app, StringBuilder cmd, IntPtr pa, IntPtr ta, bool inherit, uint flags, IntPtr env, string dir, ref STARTUPINFO si, out PROCESS_INFORMATION pi);
  [DllImport("kernel32.dll")] public static extern bool CloseHandle(IntPtr h);
  public static int Run(int pid, string app, string cmdLine) {
    IntPtr proc = OpenProcess(0x0400, false, pid);
    if (proc == IntPtr.Zero) proc = OpenProcess(0x1000, false, pid);
    if (proc == IntPtr.Zero) return 10;
    IntPtr tok;
    if (!OpenProcessToken(proc, 0x000B, out tok)) { CloseHandle(proc); return 11; }
    IntPtr dup;
    if (!DuplicateTokenEx(tok, 0xF01FF, IntPtr.Zero, 2, 1, out dup)) { CloseHandle(tok); CloseHandle(proc); return 12; }
    IntPtr env; CreateEnvironmentBlock(out env, dup, false);
    STARTUPINFO si = new STARTUPINFO(); si.cb = Marshal.SizeOf(si); si.lpDesktop = "winsta0\\default";
    PROCESS_INFORMATION pi;
    StringBuilder cmd = new StringBuilder(cmdLine);
    bool ok = CreateProcessAsUser(dup, app, cmd, IntPtr.Zero, IntPtr.Zero, false, 0x410, env, null, ref si, out pi);
    int err = ok ? 0 : Marshal.GetLastWin32Error();
    if (env != IntPtr.Zero) DestroyEnvironmentBlock(env);
    CloseHandle(dup); CloseHandle(tok); CloseHandle(proc);
    if (ok) { CloseHandle(pi.hThread); CloseHandle(pi.hProcess); }
    return err;
  }
}
"@
  }
  [WmSessRun]::Run([int]$exp.ProcessId, "$env:SystemRoot\System32\schtasks.exe", "schtasks.exe /Run /TN WinmarchyNative")
}
exit 0
"""

VFIO_DISPLAY_PS = r"""
Get-PnpDevice -Class Display -ErrorAction SilentlyContinue |
  Where-Object { $_.FriendlyName -match 'Virtual Display|Looking Glass|IVSHMEM' -or $_.InstanceId -like 'ROOT\DISPLAY*' } |
  ForEach-Object { Enable-PnpDevice -InstanceId $_.InstanceId -Confirm:$false -ErrorAction SilentlyContinue }
"""

# DXGI only works in the interactive logon session. The Looking Glass Windows
# service runs in session 0 and never produces frames. A logon task with
# highest privileges starts looking-glass-host.exe without a UAC prompt.
# Start-ScheduledTask from the guest agent runs in session 0 (DXGI = Basic Render).
# Register an elevated logon task, then ask Explorer's session to `schtasks /Run`.
LG_HOST_AUTOSTART_PS = r"""
$ErrorActionPreference = 'SilentlyContinue'
$lg = 'C:\Program Files\Looking Glass (host)\looking-glass-host.exe'
if (-not (Test-Path -LiteralPath $lg)) { exit 0 }
$svc = Get-Service -DisplayName 'Looking Glass (host)' -ErrorAction SilentlyContinue
if (-not $svc) { $svc = Get-Service -Name 'looking-glass-host' -ErrorAction SilentlyContinue }
if ($svc) {
  Stop-Service -Name $svc.Name -Force
  Set-Service -Name $svc.Name -StartupType Disabled
}
$deadline = (Get-Date).AddSeconds(70)
$exp = $null
while ((Get-Date) -lt $deadline) {
  $exp = Get-CimInstance Win32_Process -Filter "Name='explorer.exe'" | Select-Object -First 1
  if ($exp) { break }
  Start-Sleep -Seconds 2
}
if (-not $exp) { exit 0 }
$own = Invoke-CimMethod -InputObject $exp -MethodName GetOwner
$ru = if ($own.Domain) { "$($own.Domain)\$($own.User)" } else { $own.User }
if (-not $ru) { exit 0 }
Unregister-ScheduledTask -TaskName 'WinmarchyLgHost' -Confirm:$false
$action = New-ScheduledTaskAction -Execute $lg -WorkingDirectory 'C:\Program Files\Looking Glass (host)'
$trigger = New-ScheduledTaskTrigger -AtLogOn -User $ru
$trigger.Delay = 'PT10S'
$principal = New-ScheduledTaskPrincipal -UserId $ru -LogonType Interactive -RunLevel Highest
$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -DontStopOnIdleEnd -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit ([TimeSpan]::Zero)
Register-ScheduledTask -TaskName 'WinmarchyLgHost' -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
$startupDir = "C:\Users\$($own.User)\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup"
if (Test-Path -LiteralPath $startupDir) {
  Set-Content -LiteralPath "$startupDir\WinmarchyLgHost.cmd" -Encoding ASCII -Value "@echo off`r`ntimeout /t 8 /nobreak >nul`r`nschtasks /run /tn WinmarchyLgHost`r`n"
}
Add-Type -TypeDefinition @"
using System;
using System.Runtime.InteropServices;
using System.Text;
public class WmSessRun {
  [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]
  public struct STARTUPINFO {
    public int cb; public string lpReserved; public string lpDesktop; public string lpTitle;
    public int dwX, dwY, dwXSize, dwYSize, dwXCountChars, dwYCountChars, dwFillAttribute, dwFlags;
    public short wShowWindow, cbReserved2; public IntPtr lpReserved2, hStdInput, hStdOutput, hStdError;
  }
  [StructLayout(LayoutKind.Sequential)]
  public struct PROCESS_INFORMATION { public IntPtr hProcess, hThread; public int dwProcessId, dwThreadId; }
  [DllImport("kernel32.dll", SetLastError=true)] public static extern IntPtr OpenProcess(uint a, bool i, int pid);
  [DllImport("advapi32.dll", SetLastError=true)] public static extern bool OpenProcessToken(IntPtr p, uint a, out IntPtr t);
  [DllImport("advapi32.dll", SetLastError=true)] public static extern bool DuplicateTokenEx(IntPtr h, uint a, IntPtr t, int impersonation, int type, out IntPtr dup);
  [DllImport("userenv.dll", SetLastError=true)] public static extern bool CreateEnvironmentBlock(out IntPtr env, IntPtr token, bool inherit);
  [DllImport("userenv.dll", SetLastError=true)] public static extern bool DestroyEnvironmentBlock(IntPtr env);
  [DllImport("advapi32.dll", SetLastError=true, CharSet=CharSet.Unicode)]
  public static extern bool CreateProcessAsUser(IntPtr h, string app, StringBuilder cmd, IntPtr pa, IntPtr ta, bool inherit, uint flags, IntPtr env, string dir, ref STARTUPINFO si, out PROCESS_INFORMATION pi);
  [DllImport("kernel32.dll")] public static extern bool CloseHandle(IntPtr h);
  public static int Run(int pid, string app, string cmdLine) {
    IntPtr proc = OpenProcess(0x0400, false, pid);
    if (proc == IntPtr.Zero) proc = OpenProcess(0x1000, false, pid);
    if (proc == IntPtr.Zero) return 10;
    IntPtr tok;
    if (!OpenProcessToken(proc, 0x000B, out tok)) { CloseHandle(proc); return 11; }
    IntPtr dup;
    if (!DuplicateTokenEx(tok, 0xF01FF, IntPtr.Zero, 2, 1, out dup)) { CloseHandle(tok); CloseHandle(proc); return 12; }
    IntPtr env; CreateEnvironmentBlock(out env, dup, false);
    STARTUPINFO si = new STARTUPINFO(); si.cb = Marshal.SizeOf(si); si.lpDesktop = "winsta0\\default";
    PROCESS_INFORMATION pi;
    StringBuilder cmd = new StringBuilder(cmdLine);
    bool ok = CreateProcessAsUser(dup, app, cmd, IntPtr.Zero, IntPtr.Zero, false, 0x410, env, null, ref si, out pi);
    int err = ok ? 0 : Marshal.GetLastWin32Error();
    if (env != IntPtr.Zero) DestroyEnvironmentBlock(env);
    CloseHandle(dup); CloseHandle(tok); CloseHandle(proc);
    if (ok) { CloseHandle(pi.hThread); CloseHandle(pi.hProcess); }
    return err;
  }
}
"@
Get-Process -Name 'looking-glass-host' | Stop-Process -Force
Start-Sleep -Milliseconds 400
[WmSessRun]::Run([int]$exp.ProcessId, "$env:SystemRoot\System32\schtasks.exe", "schtasks.exe /Run /TN WinmarchyLgHost")
exit 0
"""


def prepare_display(mode: str) -> dict:
    vm = VM_SHARED if mode == "shared" else VM
    if _domstate(vm) != "running":
        return {"ok": False, "error": f"{vm} is not running"}
    if not wait_guest_agent(vm, 90):
        log(f"guest agent timeout on {vm}")
        return {"ok": False, "error": "guest agent timeout"}
    cmd = SHARED_DISPLAY_PS if mode == "shared" else VFIO_DISPLAY_PS
    ok = guest_pshell(vm, cmd, timeout=90)
    if mode == "shared":
        native = NATIVE_DISPLAY_PS.replace("__WIDTH__", str(SHARED_WIDTH)).replace("__HEIGHT__", str(SHARED_HEIGHT))
        ok = guest_pshell(vm, native, timeout=90) or ok
        time.sleep(3)
    lg_ok = guest_pshell(vm, LG_HOST_AUTOSTART_PS, timeout=90)
    log(f"prepare-display {mode} ok={ok} lg-host={lg_ok}")
    return {"ok": bool(ok or lg_ok)}


def spawn_prepare_display(mode: str) -> None:
    try:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "prepare-display", mode],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as exc:
        log(f"spawn prepare-display: {exc}")


def start_vm(mode: str = "vfio") -> dict:
    mode = "shared" if mode == "shared" else "vfio"
    target = VM_SHARED if mode == "shared" else VM
    other = _other_profile_running(mode)
    if other:
        return {"ok": False, "error": t("other_running", name=other)}
    if mode == "shared":
        ensured = ensure_shared_domain()
        if not ensured.get("ok"):
            return ensured
        if _domstate(target) == "running":
            spawn_prepare_display("shared")
            return {"ok": True, "state": "running", "mode": mode, "vm": target}
        proc = _virsh("start", target, timeout=90)
        if proc.returncode == 0 or "already active" in (proc.stderr or "").lower():
            log("virsh start shared ok")
            spawn_prepare_display("shared")
            return {"ok": True, "state": "running", "mode": mode, "vm": target}
        return {"ok": False, "error": (proc.stderr or proc.stdout or t("start_shared")).strip()}

    last = ""
    for attempt in range(8):
        still = holders_payload()
        blocking = [g for g in still["groups"] if not g["fatal"]]
        if blocking:
            last = t("rtx_in_use", names=", ".join(g["label"] for g in blocking))
            log(f"start wait {attempt}: {last}")
            time.sleep(0.6)
            continue
        proc = _virsh("start", target, timeout=90)
        if proc.returncode == 0:
            log("virsh start vfio ok")
            spawn_prepare_display("vfio")
            return {"ok": True, "state": "running", "mode": mode, "vm": target}
        last = (proc.stderr or proc.stdout or t("vm_fail")).strip()
        log(f"virsh start fail: {last}")
        if "already active" in last.lower():
            spawn_prepare_display("vfio")
            return {"ok": True, "state": "running", "mode": mode, "vm": target}
        time.sleep(0.7)
    return {"ok": False, "error": last or t("rtx_busy")}


def go(mode: str = "vfio") -> dict:
    mode = "shared" if mode == "shared" else "vfio"
    holders = holders_payload()
    if mode == "shared":
        started = start_vm("shared")
        if started.get("ok"):
            return {"ok": True, "phase": "ok", "mode": "shared", "vm": VM_SHARED, "released": [], "restored": []}
        return {
            "ok": False,
            "phase": "fail",
            "mode": "shared",
            "error": started.get("error") or t("shared_vm_fail"),
        }
    if holders["fatal"]:
        return {"ok": False, "phase": "blocked", "error": t("hyprland_on_rtx"), "holders": holders}
    groups = [g for g in holders["groups"] if not g["fatal"]]
    released = {"released": groups, "ok": True, "errors": []}
    if groups:
        released = release(groups)
    started = start_vm("vfio")
    restored = {"started": [], "ok": True}
    if started.get("ok"):
        restored = restore(released.get("released") or groups)
        return {
            "ok": True,
            "phase": "ok",
            "mode": "vfio",
            "vm": VM,
            "released": [g.get("id") for g in (released.get("released") or [])],
            "restored": restored.get("started"),
            "errors": (released.get("errors") or []) + (restored.get("errors") or []),
        }
    restore(released.get("released") or groups)
    return {
        "ok": False,
        "phase": "fail",
        "mode": "vfio",
        "error": started.get("error") or t("vm_fail"),
        "holders": started.get("holders") or holders_payload(),
        "errors": released.get("errors") or [],
    }


def vm_state() -> dict:
    vfio = _domstate(VM)
    shared = _domstate(VM_SHARED)
    return {"ok": True, "vfio": vfio, "shared": shared, "state": vfio or shared}


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "holders"
    mode = sys.argv[2] if len(sys.argv) > 2 else "vfio"
    if cmd == "holders":
        json.dump(holders_payload(), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "release":
        payload = json.loads(sys.stdin.read() or "{}")
        json.dump(release(payload.get("groups") or holders_payload()["groups"]), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "restore":
        payload = json.loads(sys.stdin.read() or "{}") if not sys.stdin.isatty() else {}
        json.dump(restore(payload.get("groups")), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "go":
        json.dump(go(mode), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "start-vm":
        json.dump(start_vm(mode), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "prepare-display":
        json.dump(prepare_display("shared" if mode == "shared" else "vfio"), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "ensure-shared":
        json.dump(ensure_shared_domain(), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if cmd == "vm-state":
        json.dump(vm_state(), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    print(t("usage"), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
